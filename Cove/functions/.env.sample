# Inditalk Cloud Functions — NON-SECRET configuration.
#
# Copy to functions/.env and fill in for your project. `.env` is gitignored; only this
# sample belongs in source control. Secrets (TURN_SECRET, APNS_AUTH_KEY) do NOT go here
# — they live in Secret Manager, see below and PHASE6_OPERATOR_SETUP.md.
#
# Deploy after changing:  firebase deploy --project cove-7f31f --only functions

# --- TURN relay (functions/turn.js) -----------------------------------------------
# Comma-separated relay URLs. Offer UDP and TCP; `turns:` (TLS on 5349) is what gets
# through networks that only allow HTTPS-looking traffic — exactly the networks that
# need a relay in the first place.
#
# Entries that aren't `turn:`/`turns:`/`stun:` + host[:port][?transport=udp|tcp] are
# dropped with a warning rather than handed to WebRTC (one malformed URL would otherwise
# invalidate the whole ICE server entry). Leave EMPTY until a real relay exists: clients
# then stay on STUN, which is the documented fallback, not an error.
TURN_URLS=

# Fill in once coturn is reachable, e.g.:
# TURN_URLS=turn:YOUR_TURN_HOST:3478?transport=udp,turn:YOUR_TURN_HOST:3478?transport=tcp,turns:YOUR_TURN_HOST:5349?transport=tcp

# Credential lifetime handed to clients, clamped server-side to 60s … 12h. Short is
# good: the app re-fetches per call and refreshes 60s before expiry.
TURN_TTL_SECONDS=3600

# The TURN server's shared secret is a SECRET, not an env var:
#   openssl rand -hex 32
#   firebase functions:secrets:set TURN_SECRET --project cove-7f31f
# It must equal coturn's `static-auth-secret` (with `use-auth-secret` enabled).

# --- APNs VoIP push (functions/voip.js) -------------------------------------------
# From the Apple Developer portal: Keys → your APNs key (Key ID) and Membership → Team ID.
APNS_KEY_ID=S4F7MB6BTM
APNS_TEAM_ID=
APNS_BUNDLE_ID=chat.cove.app

# FALLBACK APNs environment, used only for devices registered before the client started
# recording its own. Each device now stores `apnsEnvironment` in
# users/{uid}/privateDevices/{deviceId} (from its aps-environment entitlement), and each
# push goes to the host that device was signed for — so a Debug install and a TestFlight
# install of the same account can both ring at the same time.
#   true  -> api.sandbox.push.apple.com  (Debug builds; aps-environment=development)
#   false -> api.push.apple.com          (TestFlight/App Store; aps-environment=production)
APNS_USE_SANDBOX=true

# The .p8 auth key itself is a SECRET:
#   firebase functions:secrets:set APNS_AUTH_KEY --project cove-7f31f < /abs/path/AuthKey_S4F7MB6BTM.p8
