# Local, gitignored signing config for XcodeGen.
#
# project.yml reads DEVELOPMENT_TEAM from the INDITALK_DEVELOPMENT_TEAM environment variable
# so your Apple team id is NOT hardcoded in source and survives `xcodegen generate`.
#
# Usage:
#   cp .xcodegen.env.sample .xcodegen.env      # then set your team id below
#   set -a; source .xcodegen.env; set +a       # export it
#   xcodegen generate
#
# Find your Team ID at https://developer.apple.com/account (Membership details).
INDITALK_DEVELOPMENT_TEAM=YOUR_TEAM_ID
